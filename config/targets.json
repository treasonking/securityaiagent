{
  "schema_version": "2.0",
  "targets": {
    "lab-web": {
      "origin": "http://10.78.0.30:8080",
      "profile": {
        "profile_id": "lab-access-control",
        "revision": 1,
        "enabled": true,
        "scenarios": {
          "access-control": ["user-a", "user-b", "admin"],
          "access-control-http": ["user-a", "user-b"]
        },
        "operations": ["login", "list_own_documents", "fetch_document"],
        "limits": {
          "max_requests": 30,
          "max_tool_calls": 12,
          "timeout_seconds": 5.0,
          "run_timeout_seconds": 180.0,
          "max_response_bytes": 65536,
          "requests_per_second": 2.0,
          "max_concurrency": 1,
          "max_runs": 100,
          "state_ttl_seconds": 600.0
        }
      }
    }
  }
}
