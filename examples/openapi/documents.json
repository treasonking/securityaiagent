{
  "openapi": "3.1.0",
  "info": {
    "title": "Synthetic documents",
    "version": "1"
  },
  "security": [
    {
      "LabSession": []
    }
  ],
  "components": {
    "securitySchemes": {
      "LabSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "lab_session"
      }
    },
    "schemas": {
      "Resource": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string"
          },
          "owner_id": {
            "type": "string"
          },
          "visibility": {
            "type": "string"
          },
          "canary": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/login": {
      "post": {
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synthetic response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/documents": {
      "get": {
        "responses": {
          "200": {
            "description": "Synthetic response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "documents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "document_id": {
                            "type": "string"
                          },
                          "owner_id": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "account_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/documents/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^doc-[a-z]+-[0-9]{3}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Synthetic response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                }
              }
            }
          }
        }
      }
    }
  }
}
