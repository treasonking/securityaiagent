{
  "openapi": "3.1.0",
  "info": {
    "title": "Synthetic records",
    "version": "1"
  },
  "security": [
    {
      "LabSession": []
    }
  ],
  "components": {
    "securitySchemes": {
      "LabSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Resource": {
        "type": "object",
        "properties": {
          "record": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "owner": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  }
                }
              },
              "shared": {
                "type": "boolean"
              },
              "content": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/session": {
      "post": {
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "login_name": {
                    "type": "string"
                  },
                  "passphrase": {
                    "type": "string"
                  }
                },
                "required": [
                  "login_name",
                  "passphrase"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synthetic response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session": {
                      "type": "object",
                      "properties": {
                        "access_token": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/me/records": {
      "get": {
        "responses": {
          "200": {
            "description": "Synthetic response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "key": {
                                "type": "string"
                              },
                              "owner": {
                                "type": "object",
                                "properties": {
                                  "key": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "principal": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/records/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^doc-[a-z]+-[0-9]{3}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Synthetic response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                }
              }
            }
          }
        }
      }
    }
  }
}
