{
  "schema_version": "2.0",
  "targets": {
    "lab-web": {
      "origin": "https://127.0.0.1:54247",
      "profile": {
        "profile_id": "local-project-attachments",
        "revision": 1,
        "enabled": true,
        "scenario_id": "operator-resource-http",
        "accounts": {
          "user_a": {
            "principal_id": "member_K73",
            "resource_id": "attachment_M4s8",
            "proof_env": "OPERATOR_PROOF_A"
          },
          "user_b": {
            "principal_id": "member_R92",
            "resource_id": "attachment_N9t2",
            "proof_env": "OPERATOR_PROOF_B"
          }
        },
        "http_routes": {
          "login_path": "/gateway/authenticate",
          "me_path": "/gateway/session/profile",
          "detail_path": "/workspace/attachments/{resource_id}"
        },
        "limits": {
          "max_requests": 11,
          "max_tool_calls": 12,
          "timeout_seconds": 5.0,
          "run_timeout_seconds": 180.0,
          "max_response_bytes": 65536,
          "requests_per_second": 1000.0,
          "max_concurrency": 1,
          "max_runs": 100,
          "state_ttl_seconds": 600.0
        }
      },
      "adapter": {
        "contract_version": "operator-resource-v1",
        "adapter_id": "project-attachment-json",
        "routes": {
          "login_path": "/gateway/authenticate",
          "me_path": "/gateway/session/profile",
          "detail_path": "/workspace/attachments/{resource_id}"
        },
        "accounts": {
          "user_a": {
            "username": "cedar_editor",
            "password_env": "LAB_USER_A_PASSWORD"
          },
          "user_b": {
            "username": "quartz_reviewer",
            "password_env": "LAB_USER_B_PASSWORD"
          }
        },
        "login_user_field": "handle",
        "login_password_field": "secret",
        "auth_mode": "cookie",
        "cookie_name": "project_sid",
        "token_field": null,
        "principal_field": "context.member.subject",
        "resource_id_field": "artifact.key",
        "owner_field": "artifact.acl.holder",
        "visibility_field": "artifact.acl.classification",
        "private_value": "restricted",
        "public_value": "shared",
        "proof_field": "content.audit.receipt",
        "denial_status": 403,
        "denial_field": "problem.kind",
        "denial_value": "attachment_forbidden"
      }
    }
  }
}
